# Copy to .env and fill in. Both servers read this via the environment.

# --- hosted web client (copy these as VITE_ variables only) -----------------
# Used by `npm run dev:web` / `npm run build:web`; available in the browser.
# Use the Supabase project URL and publishable (anon) key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: set this to enable per-device Web Push subscription in Settings.
VITE_WEB_PUSH_PUBLIC_KEY=

# --- storage ---------------------------------------------------------------
# Unset  -> SQLite at product/data/app.db (dev)
# postgres://user:password@host:5432/dbname   (production)
DATABASE_URL=

# Seed the demo fixtures when the database is empty (dev only)
SEED_ON_EMPTY=0

# --- servers ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
GROUP_ID=g_design

# --- postgres TLS (when using `pg` against a managed database) -------------
# PGSSLMODE=require
# DATABASE_CA_CERT=/etc/ssl/certs/provider-ca.pem
